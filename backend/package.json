{
  "name": "@copiloto/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend NestJS (modular monolith) de Puntos Movilidad — dominios: emergency, location, navigation, mobility, traffic, simulation, assistant. La mensajeria sigue consumiendo Supabase directo desde el front (proyecto-mensajeria/); este backend cubre lo que necesita computo/estado propio (Redis, jobs, Conflict Engine).",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.0.13",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.13",
    "@nestjs/platform-express": "^11.0.13",
    "@nestjs/platform-socket.io": "^11.2.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.2.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.49.4",
    "bullmq": "^6.1.2",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "web-push": "^3"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@nestjs/cli": "^11.0.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/web-push": "^3",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  }
