# Copiar a backend/.env (nunca commitear el .env real — ver .gitignore).

NODE_ENV=development
PORT=3001

# Proyecto Supabase "Copiloto" (wrkuusacwkdazfwynhkz).
SUPABASE_URL=https://wrkuusacwkdazfwynhkz.supabase.co
# Service role key: Dashboard de Supabase -> Project Settings -> API.
# NUNCA exponer esta key al front-end ni a git.
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (decisión oficial, ADR-0008). Dashboard de Upstash -> tu base
# de datos -> pestaña "Connect" -> copiar el connection string de ioredis
# (empieza con rediss://, TLS incluido). Requerido: el backend ya NO arranca
# sin esto.
REDIS_URL=
