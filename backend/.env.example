# Copiar a backend/.env (nunca commitear el .env real — ver .gitignore).

NODE_ENV=development
PORT=3001

# Proyecto Supabase "Copiloto" (wrkuusacwkdazfwynhkz).
SUPABASE_URL=https://wrkuusacwkdazfwynhkz.supabase.co
# Service role key: Dashboard de Supabase -> Project Settings -> API.
# NUNCA exponer esta key al front-end ni a git.
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (decisión oficial, ADR-0008). Dashboard de Upstash -> tu base
# de datos -> pestaña "Connect" -> copiar el connection string de ioredis
# (empieza con rediss://, TLS incluido). Requerido: el backend ya NO arranca
# sin esto.
REDIS_URL=

# Google Maps Platform (ADR-0010) — adapters de routing/geocoding.
# https://console.cloud.google.com/google/maps-apis/credentials
# Opcional por ahora: sin esto, /navigation/* responde 503 pero el resto del
# backend arranca normal. Restringir la key a "Routes API" + "Geocoding API"
# en el dashboard de Google Cloud (nunca dejarla sin restricciones).
GOOGLE_MAPS_API_KEY=

# Web Push (ADR-0033) — genera tu propio par de llaves corriendo, desde
# backend/: `bunx web-push generate-vapid-keys`. Copia "Public Key" aquí Y
# también en proyecto-mensajeria/.env.local como VITE_VAPID_PUBLIC_KEY (la
# pública es segura de compartir con el front). "Private Key" va SOLO aquí,
# nunca la pegues en el chat con el asistente ni la subas a git. Opcional
# por ahora: sin esto, WebPushService no manda nada (solo loguea un
# warning al arrancar) pero el resto del backend funciona normal.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Un mailto: o https:// de contacto real — lo exige la especificación de Web
# Push para que los navegadores puedan avisarte si algo sale mal.
VAPID_SUBJECT=mailto:tu-correo@gmail.com

# Asistente de voz — Gemini Live API (ADR-0034). Crea la key en
# https://aistudio.google.com/apikey (usa el proyecto con saldo real, no el
# "Default Gemini Project"). Nunca la pegues en el chat con el asistente ni
# la subas a git. Opcional por ahora: sin esto, GeminiLiveService queda en
# no-op (solo loguea un warning al arrancar) pero el resto del backend
# funciona normal.
GEMINI_API_KEY=
# Nombre del modelo Live — cambia con el tiempo, se puede actualizar aquí
# sin tocar código. Verificado real contra esta cuenta al 2026-08-31 (vía
# scripts/list-gemini-live-models.ts): este modelo SÍ existe para la cuenta
# y SÍ soporta bidiGenerateContent. Ojo: exige responseModalities AUDIO (no
# TEXT) — ver comentario en gemini-live.service.ts.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
