# Copia este archivo a .env.local y completa con los valores reales del
# proyecto de Supabase (Dashboard → Project Settings → API).
# .env.local NO se commitea (ver .gitignore).

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Backend NestJS real (ver ADR-0007 en adelante) — pestaña "Copiloto"
# (Modo de manejo/Emergencia/Recordatorios/Notificaciones) le habla a este
# backend. Opcional: por defecto apunta a http://localhost:3001.
VITE_BACKEND_URL=http://localhost:3001

# Mecanismo real de registro del piloto (decisión del fundador, 2026-09-02):
# sin proveedor de SMS conectado todavía, el registro es solo con el número
# de celular, sin código — ver la nota de seguridad completa en
# src/lib/actions/auth.ts. Esta variable es OBLIGATORIA para que el registro
# funcione en cualquier ambiente (local o Railway, como build variable):
# correo real (que sí controlas) usado como base de la cuenta de cada
# usuario. Supabase rechaza dominios de mentira (ej. algo@x.test.internal)
# con "Email address is invalid", así que usamos un alias "+" sobre un
# correo real (llega a la misma bandeja, Gmail y la mayoría de proveedores
# lo soportan). Ver la nota completa en phoneOnlyCredentials() en
# src/lib/actions/auth.ts.
VITE_SHADOW_EMAIL_BASE="tu-correo@gmail.com"

# Web Push (ADR-0033) — la llave PÚBLICA del mismo par que generaste para
# backend/.env (`bunx web-push generate-vapid-keys` desde backend/). Es
# segura de tener en el front (no autentica nada por sí sola, solo identifica
# a qué backend le corresponde la suscripción). Sin esto, el botón "Activar
# notificaciones" de Ajustes queda deshabilitado con un aviso claro.
VITE_VAPID_PUBLIC_KEY=
