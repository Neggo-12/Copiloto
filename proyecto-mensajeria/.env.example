# Copia este archivo a .env.local y completa con los valores reales del
# proyecto de Supabase (Dashboard → Project Settings → API).
# .env.local NO se commitea (ver .gitignore).

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# TEMPORAL — números de celular que pasan la verificación sin enviar SMS real
# (mientras no haya proveedor de SMS de producción). Formato:
# "+<E.164>:<código de 6 dígitos>", separados por coma. Ver la nota completa
# en src/lib/actions/auth.ts. NUNCA se debe usar esto en un despliegue público.
VITE_DEV_TEST_PHONES="+573024330410:123456"
